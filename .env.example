PUBLIC_GA4_ID=G-XXXXXXXXXX
PUBLIC_CLARITY_ID=xxxxxxxxxx

# GitHub言語割合をビルド時に取得するためのトークン（ブラウザには公開されない）
# Classic PAT: Settings > Developer settings > Personal access tokens > Tokens (classic) > repo または public_repo
# Fine-grained PAT: Settings > Developer settings > Personal access tokens > Fine-grained tokens
#   Repository access: All repositories
#   Repository permissions: Metadata > Read-only
GITHUB_LANG_TOKEN=
