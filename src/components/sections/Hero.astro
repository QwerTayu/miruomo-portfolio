---
import { t } from '../../i18n/ui';
const lang = 'ja';
---

<section id="hero" class="hero">
  <div class="hero__inner container">
    <div class="hero__text fade-in">
      <h1 class="hero__name">{t(lang, 'hero.name')}</h1>
      <div class="hero__rule"></div>
      <p class="hero__role">{t(lang, 'hero.role')}</p>
      <p class="hero__sub">{t(lang, 'hero.sub')}</p>
      <div class="hero__actions">
        <a href="#works" class="btn btn--primary">{t(lang, 'hero.cta')} →</a>
        <a href="#about" class="btn btn--ghost">{t(lang, 'hero.cta2')}</a>
      </div>
    </div>

    <div class="hero__camera-wrap fade-in" style="transition-delay:0.2s">
      <!-- Phase 2: <CameraScene client:only="react" /> に差し替え -->
      <div id="camera-mount" class="camera-placeholder" aria-hidden="true"></div>
    </div>
  </div>

  <div class="hero__scroll-hint" aria-hidden="true">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-label">scroll</span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-bottom: 6rem;
    background-color: var(--color-ink);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 4rem;
    padding-top: 4rem;
    padding-bottom: 4rem;
  }

  .hero__name {
    font-family: 'DM Serif Display', serif;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.01em;
    color: var(--color-paper);
    margin-bottom: 1.25rem;
  }

  .hero__rule {
    width: 100%;
    height: 1px;
    background: var(--color-ink-2);
    margin-bottom: 1.25rem;
  }

  .hero__role {
    font-family: 'DM Mono', monospace;
    font-size: clamp(0.75rem, 1.5vw, 0.9rem);
    letter-spacing: 0.18em;
    color: var(--color-ink-3);
    margin-bottom: 0.5rem;
  }

  .hero__sub {
    font-size: 0.875rem;
    color: var(--color-ink-3);
    margin-bottom: 2.5rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  /* Camera placeholder */
  .camera-placeholder {
    width: 80px;
    height: 56px;
    border: 1.5px solid var(--color-accent);
    border-radius: 6px;
    opacity: 0.4;
    animation: float 4s ease-in-out infinite;
    flex-shrink: 0;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50%       { transform: translateY(-8px); }
  }

  /* Scroll hint */
  .hero__scroll-hint {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0.4;
    animation: fadeInUp 1s var(--ease-smooth) 1s both;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 40px;
    background: var(--color-border);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  .hero__scroll-label {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.15em;
    color: var(--color-ink-3);
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.5; transform: scaleY(1); }
    50%       { opacity: 1; transform: scaleY(0.6); }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateX(-50%) translateY(10px); }
    to   { opacity: 0.4; transform: translateX(-50%) translateY(0); }
  }

  /* Mobile */
  @media (max-width: 767px) {
    .hero__inner {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }

    .hero__camera-wrap {
      display: flex;
      justify-content: flex-start;
      order: -1;
    }
  }
</style>
