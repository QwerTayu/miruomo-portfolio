---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { t } from '../../i18n/ui';

const lang = 'ja';

const entries = await getCollection('works');
entries.sort((a, b) => {
  const aEnd = a.data.period.split('~').pop()!;
  const bEnd = b.data.period.split('~').pop()!;
  return bEnd.localeCompare(aEnd);
});

// glob loader では id が "tercet-cam/index" 形式になるので先頭セグメントをキーとして使う
const workKey = (id: string) => id.split('/')[0];

const works = await Promise.all(
  entries.map(async entry => ({
    entry,
    rendered: await render(entry),
    key: workKey(entry.id),
  })),
);
---

<section id="works" class="section section--light works">
  <div class="container">
    <header class="section-header fade-in">
      <p class="section-label">{t(lang, 'works.label')}</p>
      <h2 class="section-title">{t(lang, 'works.title')}</h2>
      <div class="section-rule" style="background: var(--color-border)"></div>
    </header>

    <div class="works-grid">
      {works.map(({ entry, key }) => (
        <article class="work-card fade-in" data-open-work={key} role="button" tabindex="0" aria-label={`${entry.data.title} の詳細を見る`}>
          {entry.data.cover && (
            <div class="work-card__cover-wrap">
              <Image
                src={entry.data.cover}
                alt={entry.data.title}
                width={600}
                height={400}
                class="work-card__cover"
              />
            </div>
          )}
          <div class="work-card__body">
            <p class="work-card__period">{entry.data.period}</p>
            <h3 class="work-card__title">{entry.data.title}</h3>
            <p class="work-card__desc">{entry.data.description}</p>
            <div class="work-card__tags">
              {entry.data.tags.map(tag => <span class="tag tag--light">{tag}</span>)}
            </div>
            <div class="work-card__footer">
              <div class="work-card__links">
                {entry.data.github && (
                  <a href={entry.data.github} target="_blank" rel="noopener noreferrer" class="work-link stop-propagation">
                    GitHub →
                  </a>
                )}
                {entry.data.demo && (
                  <a href={entry.data.demo} target="_blank" rel="noopener noreferrer" class="work-link stop-propagation">
                    Demo →
                  </a>
                )}
              </div>
              <span class="work-card__hint">詳細を見る →</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Phase 2: Three.js 暗転トランジション差し替えポイント -->
  <!-- <div id="works-three-mount"></div> -->
</section>

<!-- Hidden pre-rendered modal content store -->
<div class="modal-store" aria-hidden="true">
  {works.map(({ entry, rendered: { Content }, key }) => (
    <div id={`work-modal-${key}`}>
      {entry.data.cover && (
        <img
          src={entry.data.cover.src}
          alt={entry.data.title}
          loading="lazy"
          class="modal__cover"
        />
      )}
      <div class="modal__header">
        <p class="modal__period">{entry.data.period}</p>
        <h2 class="modal__title">{entry.data.title}</h2>
        <div class="modal__tags">
          {entry.data.tags.map(tag => <span class="tag">{tag}</span>)}
        </div>
      </div>
      <div class="modal__body prose">
        <Content />
      </div>
      <div class="modal__links">
        {entry.data.github && (
          <a href={entry.data.github} target="_blank" rel="noopener noreferrer" class="btn btn--ghost">
            GitHub →
          </a>
        )}
        {entry.data.demo && (
          <a href={entry.data.demo} target="_blank" rel="noopener noreferrer" class="btn btn--primary">
            Demo →
          </a>
        )}
      </div>
    </div>
  ))}
</div>

<!-- Modal overlay -->
<div class="modal-overlay" id="modal-overlay" aria-hidden="true" role="dialog" aria-modal="true" aria-label="作品詳細">
  <div class="modal" id="modal">
    <button class="modal__close" id="modal-close-btn" aria-label={t(lang, 'works.close')}>✕</button>
    <div class="modal__content" id="modal-content"></div>
  </div>
</div>

<style>
  /* ── Works grid ───────────────────────────── */
  .works-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-works), 1fr);
    gap: 1.5rem;
  }

  /* ── Card ──────────────────────────────────── */
  .work-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition: transform 0.2s var(--ease-smooth), border-color 0.2s, box-shadow 0.2s;
  }

  .work-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: 0 8px 24px rgba(255, 48, 29, 0.1);
  }

  .work-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .work-card__cover-wrap {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-paper-2);
  }

  .work-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-smooth);
  }

  .work-card:hover .work-card__cover {
    transform: scale(1.03);
  }

  .work-card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .work-card__period {
    font-family: 'DM Mono', monospace;
    font-size: 10px;
    color: var(--color-ink-3);
    letter-spacing: 0.05em;
  }

  .work-card__title {
    font-family: 'DM Serif Display', serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1.3;
  }

  .work-card__desc {
    font-size: 0.8rem;
    color: var(--color-ink-2);
    line-height: 1.6;
  }

  .work-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .work-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-paper-2);
  }

  .work-card__links {
    display: flex;
    gap: 1rem;
  }

  .work-link {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: var(--color-ink-3);
    transition: color 0.15s;
  }

  .work-link:hover {
    color: var(--color-accent);
  }

  .work-card__hint {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: var(--color-ink-3);
    transition: color 0.15s;
  }

  .work-card:hover .work-card__hint {
    color: var(--color-accent);
  }

  /* ── Modal store (hidden) ───────────────── */
  .modal-store {
    display: none;
  }

  /* ── Modal overlay ──────────────────────── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(10, 9, 8, 0.75);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-smooth);
  }

  .modal-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal {
    position: relative;
    background: var(--color-ink);
    border: 1px solid var(--color-ink-2);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 720px;
    max-height: 88vh;
    overflow-y: auto;
    transform: translateY(20px);
    transition: transform 0.3s var(--ease-spring);
  }

  .modal-overlay.is-open .modal {
    transform: translateY(0);
  }

  .modal__close {
    position: sticky;
    top: 0;
    float: right;
    margin: 1rem 1rem 0 0;
    font-size: 1.1rem;
    color: var(--color-ink-3);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-ink-2);
    z-index: 10;
    transition: color 0.15s, background 0.15s;
  }

  .modal__close:hover {
    color: var(--color-paper);
    background: var(--color-ink-3);
  }

  .modal__content {
    padding: 1.5rem 2rem 2rem;
  }

  /* ── Modal content styles ───────────────── */
  :global(.modal__cover) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 220px;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }

  :global(.modal__period) {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: var(--color-ink-3);
    margin-bottom: 0.4rem;
  }

  :global(.modal__title) {
    font-family: 'DM Serif Display', serif;
    font-size: 1.8rem;
    font-weight: 400;
    color: var(--color-paper);
    margin-bottom: 0.75rem;
  }

  :global(.modal__tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  :global(.modal__body) {
    border-top: 1px solid var(--color-ink-2);
    padding-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  :global(.modal__links) {
    display: flex;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-ink-2);
  }

  /* Prose styles for markdown content */
  :global(.prose h2) {
    font-family: 'DM Serif Display', serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-paper);
    margin: 1.5rem 0 0.75rem;
  }

  :global(.prose p) {
    font-size: 0.9rem;
    color: var(--color-ink-3);
    line-height: 1.8;
    margin-bottom: 0.75rem;
  }

  :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin-bottom: 1rem;
  }

  :global(.prose th) {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-ink-2);
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: var(--color-ink-3);
    letter-spacing: 0.05em;
  }

  :global(.prose td) {
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--color-ink-2);
    color: var(--color-paper);
    font-size: 0.85rem;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .modal-overlay { padding: 0; align-items: flex-end; }
    .modal {
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      max-height: 90vh;
    }
    .modal__content { padding: 1.25rem 1.25rem 2rem; }
  }
</style>

<script>
  const overlay      = document.getElementById('modal-overlay')!;
  const modalContent = document.getElementById('modal-content')!;

  function openModal(workId: string) {
    const source = document.getElementById(`work-modal-${workId}`);
    if (!source) return;
    modalContent.innerHTML = source.innerHTML;
    overlay.classList.add('is-open');
    overlay.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeModal() {
    overlay.classList.remove('is-open');
    overlay.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  // カード全体クリックでモーダルを開く
  document.querySelectorAll<HTMLElement>('[data-open-work]').forEach(card => {
    card.addEventListener('click', () => openModal(card.dataset.openWork!));
    // キーボード操作（Enter / Space）でも開けるように
    card.addEventListener('keydown', e => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openModal(card.dataset.openWork!);
      }
    });
  });

  // GitHub / Demo リンクはカードのクリックに伝播させない
  document.querySelectorAll<HTMLAnchorElement>('.stop-propagation').forEach(link => {
    link.addEventListener('click', e => e.stopPropagation());
  });

  document.getElementById('modal-close-btn')!.addEventListener('click', closeModal);

  overlay.addEventListener('click', e => {
    if (e.target === overlay) closeModal();
  });

  document.addEventListener('keydown', e => {
    if (e.key === 'Escape') closeModal();
  });
</script>
