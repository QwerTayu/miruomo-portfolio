---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { t } from "../../i18n/ui";

const lang = "ja";

const entries = await getCollection("works");
entries.sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

// glob loader では id が "tercet-cam/index" 形式になるので先頭セグメントをキーとして使う
const workKey = (id: string) => id.split("/")[0];

const works = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    rendered: await render(entry),
    key: workKey(entry.id),
  })),
);
---

<section id="works" class="section section--light works">
  <div class="container">
    <header class="section-header fade-in">
      <p class="section-label">{t(lang, "works.label")}</p>
      <h2 class="section-title">{t(lang, "works.title")}</h2>
      <div class="section-rule" style="background: var(--color-border)"></div>
    </header>

    <div class="works-sort fade-in">
      <button class="works-sort__btn is-active" data-sort="appeal">Featured</button>
      <button class="works-sort__btn" data-sort="date">Newest</button>
    </div>

    <div class="works-grid">
      {
        works.map(({ entry, key }) => (
          <article
            class="work-card fade-in"
            data-open-work={key}
            data-period={entry.data.period.split("~")[0]}
            data-order={entry.data.order ?? 999}
            role="button"
            tabindex="0"
            aria-label={`${entry.data.title} の詳細を見る`}
          >
            {entry.data.cover && (
              <div class="work-card__cover-wrap">
                <Image
                  src={entry.data.cover}
                  alt={entry.data.title}
                  width={600}
                  height={400}
                  class="work-card__cover"
                />
              </div>
            )}
            <div class="work-card__body">
              <p class="work-card__period">{entry.data.period}</p>
              <h3 class="work-card__title">{entry.data.title}</h3>
              <p class="work-card__desc">{entry.data.description}</p>
              <div class="work-card__tags">
                {entry.data.tags.map((tag) => (
                  <span class="tag tag--light">{tag}</span>
                ))}
              </div>
              <div class="work-card__footer">
                <div class="work-card__links">
                  {entry.data.github && (
                    <a
                      href={entry.data.github}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="work-link stop-propagation"
                    >
                      GitHub →
                    </a>
                  )}
                  {entry.data.live && (
                    <a
                      href={entry.data.live}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="work-link stop-propagation"
                    >
                      Live →
                    </a>
                  )}
                </div>
                <span class="work-card__hint">詳細を見る →</span>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- Phase 2: Three.js 暗転トランジション差し替えポイント -->
  <!-- <div id="works-three-mount"></div> -->
</section>

<!-- Hidden pre-rendered modal content store -->
<div class="modal-store" aria-hidden="true">
  {
    works.map(({ entry, rendered: { Content }, key }) => (
      <div id={`work-modal-${key}`}>
        {entry.data.cover && (
          <img
            src={entry.data.cover.src}
            alt={entry.data.title}
            loading="lazy"
            class="modal__cover"
          />
        )}
        <div class="modal__header">
          <p class="modal__period">{entry.data.period}</p>
          <h2 class="modal__title">{entry.data.title}</h2>
          <div class="modal__tags">
            {entry.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        </div>
        <div class="modal__body prose">
          <Content />
        </div>
        <div class="modal__links">
          {entry.data.github && (
            <a
              href={entry.data.github}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--ghost"
            >
              GitHub →
            </a>
          )}
          {entry.data.live && (
            <a
              href={entry.data.live}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary"
            >
              Live →
            </a>
          )}
        </div>
      </div>
    ))
  }
</div>

<!-- Modal overlay -->
<div
  class="modal-overlay"
  id="modal-overlay"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="作品詳細"
>
  <p class="modal-overlay__hint" aria-hidden="true">tap here to close</p>
  <div class="modal" id="modal">
    <div class="modal__content" id="modal-content"></div>
  </div>
</div>

<button class="modal__close-fab" id="modal-close-fab" aria-label={t(lang, "works.close")}>✕</button>

<style>
  /* ── Sort buttons ─────────────────────────── */
  .works-sort {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .works-sort__btn {
    font-family: "DM Mono", monospace;
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--color-ink-3);
    padding: 0.3em 0.85em;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    transition: color 0.15s, border-color 0.15s, background 0.15s;
  }

  .works-sort__btn:hover {
    color: var(--color-ink);
    border-color: var(--color-ink-3);
  }

  .works-sort__btn.is-active {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background: rgba(255, 48, 29, 0.06);
  }

  /* ── Works grid ───────────────────────────── */
  .works-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols-works), 1fr);
    gap: 1.5rem;
  }

  /* ── Card ──────────────────────────────────── */
  .work-card {
    background: var(--color-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    cursor: pointer;
    transition:
      transform 0.2s var(--ease-smooth),
      border-color 0.2s,
      box-shadow 0.2s;
  }

  .work-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
    box-shadow: 0 8px 24px rgba(255, 48, 29, 0.1);
  }

  .work-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .work-card__cover-wrap {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    background: var(--color-paper-2);
  }

  .work-card__cover {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-smooth);
  }

  .work-card:hover .work-card__cover {
    transform: scale(1.03);
  }

  .work-card__body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
  }

  .work-card__period {
    font-family: "DM Mono", monospace;
    font-size: 10px;
    color: var(--color-ink-3);
    letter-spacing: 0.05em;
  }

  .work-card__title {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ink);
    line-height: 1.4;
  }

  .work-card__desc {
    font-size: 0.8rem;
    color: var(--color-ink-2);
    line-height: 1.6;
  }

  .work-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .work-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-paper-2);
  }

  .work-card__links {
    display: flex;
    gap: 1rem;
  }

  .work-link {
    font-family: "DM Mono", monospace;
    font-size: 11px;
    color: var(--color-ink-3);
    transition: color 0.15s;
  }

  .work-link:hover {
    color: var(--color-accent);
  }

  .work-card__hint {
    font-family: "DM Mono", monospace;
    font-size: 11px;
    color: var(--color-ink-3);
    transition: color 0.15s;
  }

  .work-card:hover .work-card__hint {
    color: var(--color-accent);
  }

  /* ── Modal store (hidden) ───────────────── */
  .modal-store {
    display: none;
  }

  /* ── Modal overlay ──────────────────────── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(10, 9, 8, 0.75);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s var(--ease-smooth);
  }

  .modal-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .modal {
    position: relative;
    background: var(--color-ink);
    border: 1px solid var(--color-ink-2);
    border-radius: var(--radius-lg);
    width: 100%;
    max-width: 720px;
    max-height: 88vh;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding-top: 1.5rem;
    transform: translateY(20px);
    transition: transform 0.3s var(--ease-spring);
  }

  .modal-overlay.is-open .modal {
    transform: translateY(0);
  }

  :global(.modal__content) {
    overflow-y: auto;
    flex: 1;
    padding: 0 2rem 2rem;
  }

  /* ── Modal content styles ───────────────── */
  :global(.modal__cover) {
    display: block;
    width: 100%;
    height: auto;
    max-height: 220px;
    object-fit: cover;
    border-radius: var(--radius-md);
    margin-bottom: 1.5rem;
  }

  :global(.modal__period) {
    font-family: "DM Mono", monospace;
    font-size: 11px;
    color: var(--color-ink-3);
    margin-bottom: 0.4rem;
  }

  :global(.modal__title) {
    font-family: "DM Serif Display", serif;
    font-size: 1.8rem;
    font-weight: 400;
    color: var(--color-paper);
    margin-bottom: 0.75rem;
  }

  :global(.modal__tags) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  :global(.modal__body) {
    border-top: 1px solid var(--color-ink-2);
    padding-top: 1.5rem;
    margin-bottom: 1.5rem;
  }

  :global(.modal__links) {
    display: flex;
    gap: 0.75rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-ink-2);
  }

  /* ── Prose (GitHub-like dark) ──────────── */
  :global(.prose) {
    font-family: "Noto Sans JP", sans-serif;
    font-size: 0.9rem;
    line-height: 1.8;
    color: rgba(247, 244, 239, 0.72);
    word-break: break-word;
  }

  :global(.prose h1),
  :global(.prose h2),
  :global(.prose h3),
  :global(.prose h4),
  :global(.prose h5),
  :global(.prose h6) {
    font-family: "Noto Sans JP", sans-serif;
    font-weight: 700;
    color: var(--color-paper);
    margin-top: 1.75rem;
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  :global(.prose h1) {
    font-family: "DM Serif Display", serif;
    font-weight: 400;
  }

  :global(.prose h2) {
    font-size: 1.2rem;
    padding-bottom: 0.4em;
    border-bottom: 1px solid var(--color-ink-2);
  }

  :global(.prose h3) {
    font-size: 1rem;
  }

  :global(.prose h4) {
    font-size: 0.9rem;
  }

  :global(.prose p) {
    margin-bottom: 0.9rem;
  }

  :global(.prose strong) {
    font-weight: 400;
    color: var(--color-paper);
  }

  :global(.prose em) {
    font-style: italic;
  }

  :global(.prose ul),
  :global(.prose ol) {
    padding-left: 1.6em;
    margin-bottom: 0.9rem;
  }

  :global(.prose ul) {
    list-style-type: disc;
  }

  :global(.prose ol) {
    list-style-type: decimal;
  }

  :global(.prose li) {
    margin-bottom: 0.3rem;
    line-height: 1.75;
  }

  :global(.prose li > ul),
  :global(.prose li > ol) {
    margin-top: 0.2rem;
    margin-bottom: 0;
  }

  :global(.prose blockquote) {
    border-left: 3px solid var(--color-ink-2);
    padding: 0.3em 1em;
    margin: 0 0 0.9rem;
    color: rgba(247, 244, 239, 0.5);
  }

  :global(.prose blockquote p) {
    margin-bottom: 0;
  }

  :global(.prose code) {
    font-family: "DM Mono", monospace;
    font-size: 0.8em;
    background: rgba(247, 244, 239, 0.08);
    border: 1px solid rgba(247, 244, 239, 0.1);
    border-radius: 4px;
    padding: 0.15em 0.4em;
    color: var(--color-paper);
  }

  :global(.prose pre) {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--color-ink-2);
    border-radius: var(--radius-sm);
    padding: 1rem;
    overflow-x: auto;
    margin-bottom: 0.9rem;
  }

  :global(.prose pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: 0.85rem;
    color: var(--color-paper);
  }

  :global(.prose a) {
    color: #6bb5ff;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  :global(.prose a:hover) {
    color: #8fccff;
  }

  :global(.prose hr) {
    border: none;
    border-top: 1px solid var(--color-ink-2);
    margin: 1.5rem 0;
  }

  :global(.prose img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--radius-md);
    margin: 0.75rem 0;
    display: block;
  }

  :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.85rem;
    margin-bottom: 0.9rem;
  }

  :global(.prose thead) {
    background: rgba(247, 244, 239, 0.04);
  }

  :global(.prose th) {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-ink-2);
    font-family: "DM Mono", monospace;
    font-size: 11px;
    color: var(--color-ink-3);
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  :global(.prose td) {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-ink-2);
    color: var(--color-paper);
    font-size: 0.85rem;
  }

  :global(.prose tr:nth-child(even) td) {
    background: rgba(247, 244, 239, 0.02);
  }

  @keyframes float-hint {
    0%, 100% { transform: translateX(-50%) translateY(4); }
    50%       { transform: translateX(-50%) translateY(-12px); }
  }

  /* ── Close FAB (mobile only) ────────────── */
  .modal-overlay__hint {
    position: absolute;
    top: 2rem;
    left: 50%;
    transform: translateX(-50%);
    font-family: "DM Mono", monospace;
    font-size: 16px;
    letter-spacing: 0.1em;
    color: rgba(247, 244, 239, 0.678);
    white-space: nowrap;
    pointer-events: none;
    animation: float-hint 2.4s ease-in-out infinite;
  }

  .modal__close-fab {
    display: none;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .modal-overlay {
      padding: 0;
      align-items: flex-end;
      flex-direction: column;
      justify-content: flex-end;
    }
    .modal {
      border-radius: var(--radius-lg) var(--radius-lg) 0 0;
      max-height: 90vh;
    }
    :global(.modal__content) {
      padding: 0 1.25rem 2rem;
    }
    .modal__close-fab {
      display: flex;
      align-items: center;
      justify-content: center;
      position: fixed;
      bottom: 1.5rem;
      right: 1.5rem;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--color-ink-2);
      color: var(--color-paper);
      font-size: 1rem;
      z-index: 300;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s var(--ease-smooth);
    }
    .modal__close-fab.is-open {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>

<script>
  // ── Sort ──────────────────────────────────
  const grid = document.querySelector<HTMLElement>(".works-grid")!;

  function sortWorks(mode: "date" | "appeal") {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>(".work-card"));
    cards.sort((a, b) => {
      if (mode === "date") {
        return (b.dataset.period ?? "").localeCompare(a.dataset.period ?? "");
      }
      return Number(b.dataset.order ?? 0) - Number(a.dataset.order ?? 0);
    });
    cards.forEach((c) => grid.appendChild(c));
  }

  sortWorks("appeal");

  document.querySelectorAll<HTMLButtonElement>(".works-sort__btn").forEach((btn) => {
    btn.addEventListener("click", () => {
      document.querySelectorAll(".works-sort__btn").forEach((b) => b.classList.remove("is-active"));
      btn.classList.add("is-active");
      sortWorks(btn.dataset.sort as "date" | "appeal");
    });
  });

  // ── Modal ─────────────────────────────────
  const overlay = document.getElementById("modal-overlay")!;
  const modalContent = document.getElementById("modal-content")!;
  const closeFab = document.getElementById("modal-close-fab");

  function showModal(workId: string) {
    const source = document.getElementById(`work-modal-${workId}`);
    if (!source) return;
    modalContent.innerHTML = source.innerHTML;
    overlay.classList.add("is-open");
    overlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    closeFab?.classList.add("is-open");
  }

  function hideModal() {
    overlay.classList.remove("is-open");
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    closeFab?.classList.remove("is-open");
  }

  function openModal(workId: string) {
    const url = new URL(location.href);
    url.searchParams.set("work", workId);
    history.pushState({ work: workId }, "", url);
    showModal(workId);
  }

  function closeModal() {
    const url = new URL(location.href);
    url.searchParams.delete("work");
    history.pushState({}, "", url);
    hideModal();
  }

  // URL の ?work= に応じて表示を同期
  function syncFromUrl() {
    const workId = new URLSearchParams(location.search).get("work");
    if (workId && document.getElementById(`work-modal-${workId}`)) {
      showModal(workId);
    } else {
      if (workId) {
        const url = new URL(location.href);
        url.searchParams.delete("work");
        history.replaceState({}, "", url);
      }
      hideModal();
    }
  }

  // ブラウザの戻る / 進む
  window.addEventListener("popstate", syncFromUrl);

  // 初期表示
  syncFromUrl();

  // カード全体クリックでモーダルを開く
  document.querySelectorAll<HTMLElement>("[data-open-work]").forEach((card) => {
    card.addEventListener("click", () => openModal(card.dataset.openWork!));
    card.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        openModal(card.dataset.openWork!);
      }
    });
  });

  // GitHub / Demo リンクはカードのクリックに伝播させない
  document
    .querySelectorAll<HTMLAnchorElement>(".stop-propagation")
    .forEach((link) => {
      link.addEventListener("click", (e) => e.stopPropagation());
    });

  closeFab?.addEventListener("click", closeModal);

  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) closeModal();
  });

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeModal();
  });
</script>
