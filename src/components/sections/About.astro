---
import { t } from '../../i18n/ui';
import { manualSkills, type Skill } from '../../data/skills';

const lang = 'ja';

// GitHub API — build-time fetch
type GithubSkill = Omit<Skill, 'source'> & { source: 'github' };
let githubSkills: GithubSkill[] = [];

try {
  const token = import.meta.env.GITHUB_LANG_TOKEN;
  const headers: HeadersInit = token ? { Authorization: `Bearer ${token}` } : {};

  const repos: any[] = await fetch(
    'https://api.github.com/users/QwerTayu/repos?per_page=100&type=owner',
    { headers },
  ).then(r => r.json());

  if (Array.isArray(repos)) {
    const langBytes: Record<string, number> = {};

    await Promise.all(
      repos
        .filter(r => !r.fork && r.language)
        .map(async repo => {
          try {
            const langs: Record<string, number> = await fetch(
              repo.languages_url,
              { headers },
            ).then(r => r.json());
            for (const [lang, bytes] of Object.entries(langs)) {
              langBytes[lang] = (langBytes[lang] ?? 0) + bytes;
            }
          } catch { /* skip repo on error */ }
        }),
    );

    const total = Object.values(langBytes).reduce((a, b) => a + b, 0);
    if (total > 0) {
      githubSkills = Object.entries(langBytes)
        .sort(([, a], [, b]) => b - a)
        .slice(0, 5)
        .map(([name, bytes]) => ({
          name,
          pct: Math.round((bytes / total) * 100),
          source: 'github' as const,
        }));
    }
  }
} catch (e) {
  console.warn('[About] GitHub API fetch failed:', e);
}

const allSkills: Skill[] = [
  ...githubSkills,
  ...manualSkills,
];

const interests = ['Photography', 'Truck Camping', 'NUTMEG', 'Robocon', 'AtCoder'];
---

<section id="about" class="section about">
  <div class="container">
    <header class="section-header fade-in">
      <p class="section-label">{t(lang, 'about.label')}</p>
      <h2 class="section-title">{t(lang, 'about.title')}</h2>
      <div class="section-rule"></div>
    </header>

    <div class="about__grid">
      <!-- Avatar -->
      <div class="about__avatar-wrap fade-in">
        <!-- TODO: profile.jpg を src/assets/about/avatar.jpg に移動して <Image /> を使う -->
        <img
          src="/profile.jpg"
          alt="プロフィール写真"
          class="about__avatar"
          loading="lazy"
          width="240"
          height="240"
        />
        <p class="about__name">miruomo.com</p>
        <p class="about__affil">明石高専 → 長岡技科大</p>
      </div>

      <!-- Skills + Interests -->
      <div class="about__content">
        <div class="about__skills fade-in">
          <p class="about__subtitle">{t(lang, 'about.skills')}</p>
          <ul class="skill-list">
            {allSkills.map(skill => (
              <li class="skill-item">
                <div class="skill-item__header">
                  <span class="skill-item__name">{skill.name}</span>
                  <span class="skill-item__pct">{skill.pct}%</span>
                </div>
                <div class="skill-bar" role="progressbar" aria-valuenow={skill.pct} aria-valuemin={0} aria-valuemax={100}>
                  <div class="skill-bar__fill" style={`--pct: ${skill.pct}%`}></div>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="about__interests fade-in">
          <p class="about__subtitle">{t(lang, 'about.interests')}</p>
          <div class="interests">
            {interests.map(i => <span class="tag">{i}</span>)}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    background-color: var(--color-ink);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* Avatar column */
  .about__avatar {
    width: 100%;
    aspect-ratio: 1;
    border-radius: var(--radius-md);
    object-fit: cover;
    border: 1px solid var(--color-ink-2);
  }

  .about__name {
    font-family: 'DM Serif Display', serif;
    font-size: 1.1rem;
    margin-top: 1rem;
    color: var(--color-paper);
  }

  .about__affil {
    font-size: 0.8rem;
    color: var(--color-ink-3);
    margin-top: 0.3rem;
    font-family: 'DM Mono', monospace;
  }

  /* Skills column */
  .about__subtitle {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.18em;
    color: var(--color-accent);
    margin-bottom: 1.25rem;
  }

  .skill-list {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    margin-bottom: 2.5rem;
  }

  .skill-item__header {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.35rem;
  }

  .skill-item__name {
    font-family: 'DM Mono', monospace;
    font-size: 12px;
    color: var(--color-paper);
  }

  .skill-item__pct {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: var(--color-ink-3);
  }

  .skill-bar {
    width: 100%;
    height: 3px;
    background: var(--color-ink-2);
    border-radius: 2px;
    overflow: hidden;
  }

  .skill-bar__fill {
    height: 100%;
    width: var(--pct);
    background: var(--color-accent);
    border-radius: 2px;
  }

  .interests {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about__avatar-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .about__avatar {
      width: 140px;
    }
  }
</style>
