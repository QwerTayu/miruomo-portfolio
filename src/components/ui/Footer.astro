---
import { execSync } from 'node:child_process';
import { t } from '../../i18n/ui';
import { resolveLang } from '../../i18n/lang';

const lang = resolveLang(Astro.currentLocale);

// 最終更新日は最新コミットの日付を使う（週次 cron の再ビルドで日付が進まないように）
let updatedAt: Date;
try {
  updatedAt = new Date(execSync('git log -1 --format=%cI', { encoding: 'utf8' }).trim());
} catch {
  updatedAt = new Date();
}
if (Number.isNaN(updatedAt.getTime())) updatedAt = new Date();

const updatedIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo' }).format(updatedAt);
const updatedLabel = updatedIso.replaceAll('-', '/');
---

<footer class="footer">
  <div class="container">
    <p class="footer__copy">© 2026 miruomo.com</p>
    <p class="footer__updated">
      {t(lang, 'footer.updated')}: <time datetime={updatedIso}>{updatedLabel}</time>
    </p>
  </div>
</footer>

<style>
  .footer {
    padding: 2rem 0;
    border-top: 1px solid var(--color-ink-2);
  }

  .footer__copy,
  .footer__updated {
    font-family: 'DM Mono', monospace;
    font-size: 11px;
    color: var(--color-ink-3);
    text-align: center;
  }

  .footer__updated {
    margin-top: 0.25rem;
  }
</style>
