---
// src/pages/index.astro
const links = [
  { name: 'GitHub', url: 'https://github.com/QwerTayu', icon: '💻' },
  { name: 'Instagram', url: 'https://instagram.com/_qwert0916', icon: '📸' },
  { name: 'X (Twitter)', url: 'https://x.com/tayu99_qwert', icon: '📱' },
  { name: 'Zenn', url: 'https://zenn.dev/tayu99_make', icon: '📝' },
  { name: 'Qiita', url: 'https://qiita.com/QwerTayu', icon: '🚀' },
];
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>miruomo.com | Under Construction</title>
	</head>
	<body>
		<main class="container">
			<h1>miruomo.com</h1>
			<p class="status">🚧 Under Construction 🚧</p>
			<p class="description">現在、ポートフォリオサイトを制作中です。完成まで今しばらくお待ちください。</p>
			
			<div class="links-container">
				{links.map((link) => (
					<a href={link.url} target="_blank" rel="noopener noreferrer" class="link-card">
						<span class="icon">{link.icon}</span>
						<span class="name">{link.name}</span>
					</a>
				))}
			</div>
		</main>
	</body>
</html>

<style>
	:root {
		--bg-color: #f8f9fa;
		--text-color: #212529;
		--accent-color: #495057;
		--card-bg: #ffffff;
		--card-hover: #e9ecef;
	}

	body {
		font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
		background-color: var(--bg-color);
		color: var(--text-color);
		margin: 0;
		display: flex;
		justify-content: center;
		align-items: center;
		min-height: 100vh;
	}

	.container {
		text-align: center;
		padding: 2rem;
		max-width: 400px;
		width: 100%;
	}

	h1 {
		font-size: 2.5rem;
		margin-bottom: 0.5rem;
		font-weight: 700;
		letter-spacing: -0.05em;
	}

	.status {
		font-weight: bold;
		color: #f39c12;
		margin-bottom: 1.5rem;
	}

	.description {
		font-size: 0.9rem;
		color: #6c757d;
		margin-bottom: 2.5rem;
		line-height: 1.6;
	}

	.links-container {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.link-card {
		display: flex;
		align-items: center;
		padding: 0.75rem 1rem;
		background-color: var(--card-bg);
		border: 1px solid #dee2e6;
		border-radius: 8px;
		text-decoration: none;
		color: var(--text-color);
		font-weight: 500;
		transition: background-color 0.2s, transform 0.2s;
	}

	.link-card:hover {
		background-color: var(--card-hover);
		transform: translateY(-2px);
	}

	.icon {
		margin-right: 1rem;
		font-size: 1.2rem;
	}

	.name {
		flex-grow: 1;
		text-align: left;
	}
</style>
